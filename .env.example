# مهم للبيانات الدائمة على Vercel (بدونه الطلبات والتعديلات بتضيع مع كل تشغيل بارد)
# انسخهم بالظبط من: upstash.com -> قاعدة البيانات -> REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# كلمة سر قوية للوحة التحكم /admin (بدونها يتولد كلمة سر عشوائية مع كل تشغيل)
ADMIN_PASSWORD=

# على Vercel مفعّل تلقائيًا. محليًا سيبه فاضي إلا لو شغّلت السيرفر ورا Proxy
TRUST_PROXY=
